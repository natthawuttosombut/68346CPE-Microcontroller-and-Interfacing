/* รายชื่อสมาชิก
* เปลี่ยนชื่อเป็นชื่อจริงของกลุ่มได้
*/
char *member[MEMBER_COUNT] =
{
    "Hatthakorn Naksakun",
    "Natthawut Tosombut",
    "Anuwat keawduangdee"
};
 
/* ลำดับสมาชิก */
int member_index = 0;
 
/* สถานะหน้า
*
* 0 = หน้าแรก
* 1 = หน้าแสดงสมาชิก
*/
int page = 0;
 
