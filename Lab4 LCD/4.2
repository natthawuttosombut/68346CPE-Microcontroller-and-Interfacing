/* =========================================================
* แสดงหน้าแรก
* ========================================================= */
void Show_Home(void)
{
    /* Clear LCD */
    lcd_clear();
 
    HAL_Delay(10);
 
    /* บรรทัดที่ 1 */
    lcd_put_cur(0, 0);
    lcd_send_string("Member List");
 
    /* บรรทัดที่ 2 */
    lcd_put_cur(1, 0);
    lcd_send_string("Press Button");
 
    /* กลับสถานะหน้าแรก */
    page = 0;
 
    /* เริ่มนับสมาชิกใหม่ */
    member_index = 0;
}
 
 
/* =========================================================
* แสดงสมาชิก
* ========================================================= */
void Show_Member(void)
{
    /* Clear LCD */
    lcd_clear();
 
    HAL_Delay(10);
 
    /* บรรทัดที่ 1 */
    lcd_put_cur(0, 0);
    lcd_send_string("Member:");
 
    /* บรรทัดที่ 2 */
    lcd_put_cur(1, 0);
    lcd_send_string(member[member_index]);
 
    /* อยู่หน้าแสดงสมาชิก */
    page = 1;
}
 
 
/* USER CODE END 0 */
 
 
/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
    /* USER CODE BEGIN 1 */
 
    /* USER CODE END 1 */
 
 
    /* MCU Configuration--------------------------------------------------------*/
 
    HAL_Init();
 
 
    /* USER CODE BEGIN Init */
 
    /* USER CODE END Init */
 
 
    /* Configure the system clock */
    SystemClock_Config();
 
 
    /* USER CODE BEGIN SysInit */
 
    /* USER CODE END SysInit */
 
 
    /* Initialize all configured peripherals */
    MX_GPIO_Init();
    MX_I2C1_Init();
 
 
    /* USER CODE BEGIN 2 */
 
    /* เริ่มต้น LCD */
    lcd_init();
 
    /* แสดงหน้าแรก */
    Show_Home();
 
    /* USER CODE END 2 */
 
 
    /* Infinite loop */
    /* USER CODE BEGIN WHILE */
 
    while (1)
    {
 
        /* =====================================================
         * SW1 = A0
         *
         * กดครั้งแรก -> Member 1
         * กดครั้งที่สอง -> Member 2
         * กดครั้งที่สาม -> Member 3
         * กดครั้งที่สี่ -> Member 4
         * ===================================================== */
 
        if (HAL_GPIO_ReadPin(GPIOA, SW1_PIN) == GPIO_PIN_RESET)
        {
            /* Debounce */
            HAL_Delay(30);
 
            /* ตรวจสอบอีกครั้ง */
            if (HAL_GPIO_ReadPin(GPIOA, SW1_PIN) == GPIO_PIN_RESET)
            {
 
                /* -----------------------------------------
                 * ถ้าอยู่หน้าแรก
                 * ให้เริ่มแสดงสมาชิกคนที่ 1
                 * ----------------------------------------- */
                if (page == 0)
                {
                    member_index = 0;
 
                    Show_Member();
                }
 
                /* -----------------------------------------
                 * ถ้าอยู่หน้า Member
                 * ให้เปลี่ยนเป็นคนถัดไป
                 * ----------------------------------------- */
                else
                {
                    if (member_index < MEMBER_COUNT - 1)
                    {
                        member_index++;
 
                        Show_Member();
                    }
                }
 
 
                /* -----------------------------------------
                 * รอจนกว่าจะปล่อย SW1
                 * ----------------------------------------- */
                while (HAL_GPIO_ReadPin(GPIOA, SW1_PIN)
                       == GPIO_PIN_RESET)
                {
                    HAL_Delay(10);
                }
            }
        }
 
 
        /* =====================================================
         * SW2 = A1
         *
         * กด -> Clear LCD
         *      -> กลับหน้า Member List
         * ===================================================== */
 
        if (HAL_GPIO_ReadPin(GPIOA, SW2_PIN) == GPIO_PIN_RESET)
        {
            /* Debounce */
            HAL_Delay(30);
 
            /* ตรวจสอบอีกครั้ง */
            if (HAL_GPIO_ReadPin(GPIOA, SW2_PIN) == GPIO_PIN_RESET)
            {
 
                /* Clear LCD */
                lcd_clear();
 
                HAL_Delay(10);
 
                /* -----------------------------------------
                 * แสดงหน้าแรก
                 * ----------------------------------------- */
 
                lcd_put_cur(0, 0);
                lcd_send_string("Member List");
 
                lcd_put_cur(1, 0);
                lcd_send_string("Press Button");
 
                /* กลับสถานะหน้าแรก */
                page = 0;
 
                /* เริ่มสมาชิกใหม่ */
                member_index = 0;
 
 
                /* -----------------------------------------
                 * รอจนกว่าจะปล่อย SW2
                 * ----------------------------------------- */
 
                while (HAL_GPIO_ReadPin(GPIOA, SW2_PIN)
                       == GPIO_PIN_RESET)
                {
                    HAL_Delay(10);
                }
            }
        }
 
        /* USER CODE END WHILE */
 
        /* USER CODE BEGIN 3 */
 
    }
 
    /* USER CODE END 3 */
}
 
 
